OPENAI_API_KEY=

# OpenAI models used by LightRAG: the LLM extracts entities/relationships at
# ingest time and writes answers at query time.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Where LightRAG keeps its knowledge graph (NetworkX GraphML), vector
# indexes (nano-vectordb), and caches.
WORKING_DIR=rag_storage
DOCS_DIR=docs

# Query mode: naive | local | global | hybrid | mix. "hybrid" combines
# entity-level (local) and relationship/theme-level (global) graph retrieval.
QUERY_MODE=hybrid
# Earlier conversation turns sent with each question, for follow-ups.
HISTORY_TURNS=6

CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100
# Concurrent LLM calls during ingestion.
LLM_MAX_ASYNC=8

CORS_ORIGINS=http://localhost:3000
